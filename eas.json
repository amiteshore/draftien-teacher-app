      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.draftien.com",
        "EXPO_PUBLIC_WEB_CLIENT_ID": "278245411954-rg7tuvi14arcq380isis48qh3m32g204.apps.googleusercontent.com",
        "EXPO_PUBLIC_IOS_CLIENT_ID": "278245411954-t56qir1uathv59me9b9m339uf2kso95i.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
